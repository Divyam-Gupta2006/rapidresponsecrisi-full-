# Dual-Server Whisper Configuration
# Update these values based on your environment

# Main entry point (Priority Router)
EXPO_PUBLIC_WHISPER_BASE_URL=http://10.162.69.45:5000

# Optional: Individual server endpoints (for direct access)
EXPO_PUBLIC_WHISPER_WAKE_URL=http://10.162.69.45:5001
EXPO_PUBLIC_WHISPER_SOS_URL=http://10.162.69.45:5002

# Router status check interval (milliseconds)
EXPO_PUBLIC_ROUTER_HEALTH_CHECK_INTERVAL=30000

# Request timeouts
EXPO_PUBLIC_WHISPER_WAKE_TIMEOUT=15000      # 15 seconds for wake
EXPO_PUBLIC_WHISPER_SOS_TIMEOUT=30000       # 30 seconds for SOS (higher priority)

# Audio processing
EXPO_PUBLIC_AUDIO_SAMPLE_RATE=16000
EXPO_PUBLIC_AUDIO_CHANNELS=1
EXPO_PUBLIC_AUDIO_ENCODING=pcm_16bit
